rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tilgang styres av dokumentet config/access:
    //   evaluators: [e-poster]  – evalueringsgruppen: tropper, spillere, opprette/slette kamper
    //   readers:    [e-poster]  – øvrige: kan se alt og oppdatere kamper, men ikke endre tropper, kampposisjoner eller oppstilling
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return request.auth != null && email() == "adrian.rutle@gmail.com";
    }
    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }
    function isEval() {
      return isOwner() || (request.auth != null && email() in access().get("evaluators", []));
    }
    function isMember() {
      return isEval() || (request.auth != null && email() in access().get("readers", []));
    }

    match /config/access {
      allow read: if isMember();
      allow write: if isOwner();
    }
    // Felles parametre for automatisk laguttak
    match /config/assignment {
      allow read: if isMember();
      allow write: if isEval();
    }
    match /matches/{id} {
      allow read: if isMember();
      allow create, delete: if isEval();
      allow update: if isEval() ||
        (isMember() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["squad", "positions", "formation", "lineup", "slotXY", "absent"]));
    }
    match /players/{id} {
      allow read: if isMember();
      allow write: if isEval();
    }
    // Chat: «Alle» for alle med tilgang, «Evalueringsgruppen» bare for evalueringsgruppen.
    // Man kan bare skrive i eget navn, og bare slette egne meldinger (eier kan slette alle).
    match /chat_alle/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == email();
      allow delete: if isOwner() || (isMember() && resource.data.by == email());
    }
    match /chat_img_alle/{id} {
      allow read: if isMember();
      allow create: if isMember() && request.resource.data.by == email();
      allow delete: if isOwner() || (isMember() && resource.data.by == email());
    }
    match /chat_eval/{id} {
      allow read: if isEval();
      allow create: if isEval() && request.resource.data.by == email();
      allow delete: if isOwner() || (isEval() && resource.data.by == email());
    }
    match /chat_img_eval/{id} {
      allow read: if isEval();
      allow create: if isEval() && request.resource.data.by == email();
      allow delete: if isOwner() || (isEval() && resource.data.by == email());
    }
  }
}
