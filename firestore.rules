rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tilgang styres av dokumentet config/access:
    //   evaluators: [e-poster]  – evalueringsgruppen: tropper, spillere, opprette/slette kamper
    //   readers:    [e-poster]  – øvrige: kan se alt og oppdatere kamper, men ikke endre tropper, kampposisjoner eller oppstilling
    function email() {
      return request.auth.token.email.lower();
    }
    function isOwner() {
      return request.auth != null && email() == "adrian.rutle@gmail.com";
    }
    function access() {
      return get(/databases/$(database)/documents/config/access).data;
    }
    function isEval() {
      return isOwner() || (request.auth != null && email() in access().get("evaluators", []));
    }
    function isMember() {
      return isEval() || (request.auth != null && email() in access().get("readers", []));
    }

    match /config/access {
      allow read: if isMember();
      allow write: if isOwner();
    }
    match /matches/{id} {
      allow read: if isMember();
      allow create, delete: if isEval();
      allow update: if isEval() ||
        (isMember() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["squad", "positions", "formation", "lineup", "slotXY"]));
    }
    match /players/{id} {
      allow read: if isMember();
      allow write: if isEval();
    }
  }
}
